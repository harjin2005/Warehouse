# Runtime connection: the FastAPI app connects as `warehouse_runtime`, a
# plain LOGIN role with no superuser/BYPASSRLS privileges (created by
# migrations/versions/0003_runtime_role.py), so RLS policies actually
# restrict what it can see. Never point this at warehouse_migrator.
# Port 55432 matches docker-compose.yml's host port mapping (5432 is often
# already taken by another project's Postgres container on dev machines).
DATABASE_URL=postgresql+asyncpg://warehouse_runtime:warehouse_runtime_dev_password@localhost:55432/warehouse

# Migration connection: alembic needs an elevated/superuser-equivalent role
# (CREATE ROLE, ALTER TABLE ... ENABLE ROW LEVEL SECURITY, etc.) that the
# running app must never use for ordinary request traffic.
MIGRATION_DATABASE_URL=postgresql+asyncpg://warehouse_migrator:warehouse_migrator@localhost:55432/warehouse

# Password migration 0003 uses to create/alter the warehouse_runtime role.
# MUST match the password embedded in DATABASE_URL above -- if these two
# diverge, uvicorn will fail to authenticate as warehouse_runtime. The
# literal below is a documented dev/test-only default; every real
# environment (staging/production) MUST set this to a real secret, or
# migration 0003 refuses to run (see its docstring).
RUNTIME_DB_PASSWORD=warehouse_runtime_dev_password

JWT_SECRET=replace-with-a-real-random-secret
ENVIRONMENT=development
